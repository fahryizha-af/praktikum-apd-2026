USERNAME_BENAR = "Fahry"
PASSWORD_BENAR = "106"

print("=" * 44)
print("   APLIKASI REKAPITULASI UANG SAKU BULANAN")
print("=" * 44)

percobaan = 3
login_berhasil = False

while percobaan > 0:
    username = input("Username : ").strip()
    password = input("Password : ").strip()

    if username == "" or password == "":
        print("Username/Password tidak boleh kosong!\n")
    elif username == USERNAME_BENAR and password == PASSWORD_BENAR:
        login_berhasil = True
        print("\nLogin Berhasil\n")
        break
    else:
        percobaan -= 1
        print("Login Gagal. Sisa percobaan:", percobaan, "\n")

if not login_berhasil:
    print("=" * 44)
    print("  ERROR: Percobaan login habis. Akses ditolak!")
    print("=" * 44)

if login_berhasil:
    while True:
        teks = input("Masukkan uang saku awal: Rp").strip()
        if teks.isdigit() and int(teks) > 0:
            uang_bulanan = int(teks)
            break
        else:
            print("Input harus berupa angka lebih dari 0, tanpa spasi/huruf!")

    total_pengeluaran = 0

    while uang_bulanan > 0:
        print("\n" + "=" * 44)
        print("               MENU UTAMA")
        print("=" * 44)
        print("  1. Catat Pengeluaran")
        print("  2. Cek Sisa Uang Saku")
        print("  3. Keluar")
        print("-" * 44)
        pilihan = input("Pilih menu (1-3): ").strip()

        if pilihan == "1":
            lagi = "Y"
            while lagi == "Y":
                while True:
                    teks = input("\nMasukkan nominal pengeluaran: Rp").strip()
                    if not teks.isdigit() or int(teks) == 0:
                        print("Input harus berupa angka lebih dari 0!")
                    elif int(teks) > uang_bulanan:
                        print("Saldo tidak cukup! Sisa saldo: Rp" + f"{uang_bulanan:,}")
                    else:
                        nominal = int(teks)
                        break

                uang_bulanan -= nominal
                total_pengeluaran += nominal
                print("Pengeluaran tercatat!")
                print("Sisa uang saku: Rp" + f"{uang_bulanan:,}")

                if uang_bulanan == 0:
                    break

                while True:
                    jawab = input("Apakah Anda ingin mencatat pengeluaran lagi? (Y/T): ").strip().upper()
                    if jawab == "Y" or jawab == "T":
                        break
                    else:
                        print("Input tidak valid! Ketik Y atau T saja.")
                lagi = jawab

        elif pilihan == "2":
            print("\n" + "-" * 44)
            print("  Sisa Uang Saku    : Rp" + f"{uang_bulanan:,}")
            print("  Total Pengeluaran : Rp" + f"{total_pengeluaran:,}")
            print("-" * 44)

        elif pilihan == "3":
            print("\nTerima kasih telah menggunakan aplikasi ini, " + USERNAME_BENAR + "!")
            break

        else:
            print("Pilihan tidak valid! Masukkan angka 1, 2, atau 3.")

    if uang_bulanan == 0:
        print("\n" + "=" * 44)
        print("  Uang saku Anda sudah habis!")
        print("  Total Pengeluaran : Rp" + f"{total_pengeluaran:,}")
        print("  Terima kasih telah menggunakan aplikasi ini!")
        print("=" * 44)